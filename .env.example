# Discord Developer Portal -> Bot -> Reset Token (НЕ "Public Key" и не "Application ID")
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1550806087605686352
# Оставь пустым для регистрации команд глобально (до 1 часа на обновление),
# либо укажи ID своего сервера для мгновенной регистрации во время разработки.
DISCORD_GUILD_ID=

# Путь к бинарнику yt-dlp. Если он в PATH - оставь просто "yt-dlp".
YTDLP_PATH=yt-dlp
# Путь к бинарнику ffmpeg. Если он в PATH - оставь просто "ffmpeg".
FFMPEG_PATH=ffmpeg
# Опционально: путь к cookies.txt (формат Netscape) для yt-dlp. Нужен, если YouTube отвечает
# "Sign in to confirm you're not a bot" - с IP хостингов/VPS это бывает часто. В Docker положи файл
# в ./data (он примонтирован в контейнер) и укажи YTDLP_COOKIES=/app/data/cookies.txt
YTDLP_COOKIES=

# Опционально: каталог для JSON-файлов состояния (привязки Dota, опубликованные раздачи). По умолчанию ./data.
# DATA_DIR=

# Через сколько секунд бот выйдет из голосового канала после конца очереди или когда все вышли.
MUSIC_LEAVE_DELAY_SECONDS=30

# Единый канал для ВСЕХ ежедневных уведомлений: погода, статистика Dota, напоминание/похвала
# (правой кнопкой на канал -> Copy Channel ID, нужен включенный Developer Mode в настройках Discord).
# Старое имя WEATHER_CHANNEL_ID тоже ещё читается, но лучше перейти на NOTIFY_CHANNEL_ID.
NOTIFY_CHANNEL_ID=
# Список городов для ежедневного прогноза и для /weather без параметров, через запятую.
# Можно на русском, например "Москва,Санкт-Петербург,Алматы".
WEATHER_CITIES=Moscow,Kyiv
# Время ежедневной отправки прогноза в формате cron (по умолчанию 08:00).
WEATHER_CRON=0 8 * * *
# Таймзона для cron и для самого прогноза, см. список tz database names.
WEATHER_TIMEZONE=Europe/Moscow

# Опционально: аккаунт Dota 2 (account_id, НЕ SteamID64) по умолчанию для /dota без параметров.
DOTA_DEFAULT_ACCOUNT_ID=
# Ежедневная статистика по этому account_id (часы в игре, матчи за сегодня, последний матч).
# Когда слать (cron) и в какой таймзоне считать "сегодня". По умолчанию 23:00, таймзона как у погоды.
DOTA_CRON=0 23 * * *
DOTA_TIMEZONE=Europe/Moscow
# Опционально: Steam Web API key (https://steamcommunity.com/dev/apikey) - тогда покажет реальное
# время в Dota 2 как в библиотеке Steam. Без него считается только сумма длительностей матчей из OpenDota.
# У игрока в Steam должны быть открыты "Данные об играх".
STEAM_API_KEY=

# Напоминание "пора играть": в DOTA_ALERT_CRON бот пингует пользователя DOTA_ALERT_USER_ID
# (Discord ID, не Dota!): если за сегодня сыграно меньше DOTA_ALERT_MIN_HOURS часов - напоминанием,
# если не меньше - похвалой.
# Считает по DOTA_ALERT_ACCOUNT_ID (если пусто - DOTA_DEFAULT_ACCOUNT_ID), пишет в NOTIFY_CHANNEL_ID.
DOTA_ALERT_USER_ID=
DOTA_ALERT_ACCOUNT_ID=
DOTA_ALERT_MIN_HOURS=2
DOTA_ALERT_CRON=0 13 * * *

# Уведомление "давно не было в сети": в OFFLINE_ALERT_CRON бот пишет в NOTIFY_CHANNEL_ID, сколько
# дней подряд пользователи из OFFLINE_ALERT_USER_IDS (Discord ID через запятую) не появлялись в сети,
# если это не меньше OFFLINE_ALERT_MIN_DAYS. Пустой список - функция выключена.
# Нужен включённый Presence Intent: Developer Portal -> Bot -> Privileged Gateway Intents.
OFFLINE_ALERT_USER_IDS=
OFFLINE_ALERT_MIN_DAYS=1
OFFLINE_ALERT_CRON=0 12 * * *
# Опционально: по умолчанию как WEATHER_TIMEZONE.
# OFFLINE_ALERT_TIMEZONE=Europe/Moscow

# Автопост бесплатных раздач Epic Games и Steam в NOTIFY_CHANNEL_ID.
# Как часто проверять (cron) и регион Epic (двухбуквенный код страны).
FREEGAMES_CRON=0 */2 * * *
FREEGAMES_COUNTRY=RU

# Ссылки на бэкап/клиент-пак Minecraft-сервера (link-server из репозитория minecraft-server,
# переменные BACKUP_SERVER_PORT/BACKUP_LINK_TOKEN там же в .env - те же значения сюда).
# Пример: MINECRAFT_LINK_BASE_URL=http://12.34.56.78:8090
MINECRAFT_LINK_BASE_URL=
MINECRAFT_LINK_TOKEN=
# Опционально: если задан, /minecraft работает только в этом канале (ПКМ по каналу -> Copy Channel ID).
MINECRAFT_CHANNEL_ID=
# Клиент-пак прикладывается файлом к ответу, только если не больше этого размера (МБ) -
# иначе бот просто пришлёт ссылку. Лимит вложений Discord у небустнутых серверов - от 10 МБ.
MINECRAFT_CLIENT_ATTACH_MAX_MB=8

# Опционально: Spotify Client ID/Secret (https://developer.spotify.com/dashboard).
# Без них ссылки на треки/плейлисты Spotify всё равно работают. Нужны только для
# текстового поиска именно через Spotify API - в этом боте не используется,
# т.к. обычный текстовый поиск и так идёт через YouTube.
# DP_SPOTIFY_CLIENT_ID=
# DP_SPOTIFY_CLIENT_SECRET=
